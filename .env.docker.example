# Copy this file to .env.docker and replace every placeholder.
# Never commit .env.docker.

COMPOSE_PROJECT_NAME=leginabroad
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,leginabroad.com,www.leginabroad.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://leginabroad.com,https://www.leginabroad.com
# Keep these false only for direct local HTTP testing. Set all three to true on
# the VPS, where Nginx terminates HTTPS and forwards X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_LOG_LEVEL=INFO

# Use host.docker.internal while PostgreSQL remains on the Docker host.
# PostgreSQL must listen on an address reachable from the Docker bridge and
# pg_hba.conf must permit the Docker network. Do not expose port 5432 publicly.
POSTGRESQL_NAME=replace-me
POSTGRESQL_USER=replace-me
POSTGRESQL_PASSWORD=replace-me
HOST_NAME=host.docker.internal
PORT=5432

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_S3_SIGNATURE_NAME=s3v4
AWS_S3_REGION_NAME=replace-me
